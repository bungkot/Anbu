# Copy to .env:  cp .env.example .env

# --- Ollama model ---
# granite3.3:2b (IBM, Apache 2.0): 1.5 GB Q4, 128K context, native function
# calling. Chosen for the 3 GB Docker Desktop budget: model + KV cache fits in
# the 2g Ollama limit while leaving room for the app container.
OLLAMA_MODEL=granite3.3:2b

# Ollama container memory limit. Total stack target: 2g (ollama) + 0.75g (app).
# Must stay below Docker Desktop memory and leave headroom for the VM.
OLLAMA_MEM_LIMIT=2g

# app container memory limit.
APP_MEM_LIMIT=0.75g

# Context length. Granite 2B weights are 1.5 GB; 8192 keeps the q8_0 KV cache
# (with flash attention) inside the 2g Ollama limit.
OLLAMA_CONTEXT_LENGTH=8192

# Used when OpenCode/SDK runs ON THE HOST (not in a container).
# Inside containers this value is overridden to http://ollama:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenCode server binding used by the embedded SDK server.
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096

# --- Agentic pentester (see docs/scope-and-authorization.md) ---
# Scope document for the run. The engine refuses to start without a valid scope.
ANBU_SCOPE_FILE=scope/example.json

# Evidence output directory (keep outside the repository or gitignored).
ANBU_EVIDENCE_DIR=workspace/evidence

# Authorization token referenced by the scope document. Never commit a real token.
ANBU_AUTH_TOKEN=

# Default runtime budgets (overridable in the scope document).
ANBU_MAX_REQUESTS=800
ANBU_MAX_DURATION_MINUTES=60
ANBU_REQUESTS_PER_SECOND_PER_HOST=5

# Read-only by default. State-changing tests require explicit approval.
ANBU_READ_ONLY=true
