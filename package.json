{
  "name": "anbu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authorized agentic TypeScript web security pentester using the OpenCode SDK, Ollama, and the OWASP Top 10:2025 methodology",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "doctor": "tsx src/index.ts doctor",
    "ask": "tsx src/index.ts ask",
    "intake": "tsx src/index.ts intake",
    "test": "node scripts/test.mjs test/unit",
    "stack:build": "docker compose build app",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f ollama",
    "stack:exec": "docker compose exec app node /app/dist/index.js",
    "stack:ask": "docker compose run --rm --entrypoint node app /app/dist/index.js ask"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@opencode-ai/sdk": "1.19.5",
    "opencode-ai": "1.19.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
